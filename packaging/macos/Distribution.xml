<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  productbuild distribution for Gen VST. __VERSION__ is replaced by build-pkg.sh.
  All four components are required (no opt-out) for the v0.1 release. Future
  versions can expose pkg-ref `auth="root"` toggles to let the user uncheck
  formats they don't want.
-->
<installer-gui-script minSpecVersion="1">
    <title>Gen VST __VERSION__</title>
    <organization>com.genvst</organization>
    <license language="en" mime-type="text/plain">Gen VST is licensed under the GNU General Public License v3.0. See https://github.com/binbuf/gen-vst/blob/main/LICENSE for the full text.</license>
    <welcome language="en" mime-type="text/plain">Gen VST — Sega Genesis YM2612 + SN76489 emulation as a VST3 / AU / CLAP / Standalone plug-in.

This installer places:
  * the VST3 plug-in in /Library/Audio/Plug-Ins/VST3
  * the AU component in /Library/Audio/Plug-Ins/Components
  * the CLAP plug-in in /Library/Audio/Plug-Ins/CLAP
  * the Standalone application in /Applications

This release is unsigned. Gatekeeper may warn the first time you open the installer.</welcome>
    <conclusion language="en" mime-type="text/plain">Gen VST is installed.

In your DAW: rescan plug-ins and pick "Gen VST" (Instrument / Synth).
Or run /Applications/Gen VST.app for the Standalone host.

Factory patches (39 FM .tfi + 12 SQ .psg) ship inside each plug-in bundle.</conclusion>

    <pkg-ref id="com.genvst.vst3"/>
    <pkg-ref id="com.genvst.au"/>
    <pkg-ref id="com.genvst.standalone"/>
    <pkg-ref id="com.genvst.clap"/>

    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>

    <choices-outline>
        <line choice="default">
            <line choice="com.genvst.vst3"/>
            <line choice="com.genvst.au"/>
            <line choice="com.genvst.standalone"/>
            <line choice="com.genvst.clap"/>
        </line>
    </choices-outline>

    <choice id="default"/>

    <choice id="com.genvst.vst3" title="VST3 plug-in" description="Installs the VST3 to /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.genvst.vst3"/>
    </choice>

    <choice id="com.genvst.au" title="Audio Unit" description="Installs the AU component to /Library/Audio/Plug-Ins/Components.">
        <pkg-ref id="com.genvst.au"/>
    </choice>

    <choice id="com.genvst.standalone" title="Standalone application" description="Installs the Standalone app to /Applications.">
        <pkg-ref id="com.genvst.standalone"/>
    </choice>

    <choice id="com.genvst.clap" title="CLAP plug-in" description="Installs the CLAP to /Library/Audio/Plug-Ins/CLAP.">
        <pkg-ref id="com.genvst.clap"/>
    </choice>

    <pkg-ref id="com.genvst.vst3"        version="__VERSION__" onConclusion="none">Gen-VST-VST3.pkg</pkg-ref>
    <pkg-ref id="com.genvst.au"          version="__VERSION__" onConclusion="none">Gen-VST-AU.pkg</pkg-ref>
    <pkg-ref id="com.genvst.standalone"  version="__VERSION__" onConclusion="none">Gen-VST-Standalone.pkg</pkg-ref>
    <pkg-ref id="com.genvst.clap"        version="__VERSION__" onConclusion="none">Gen-VST-CLAP.pkg</pkg-ref>
</installer-gui-script>
